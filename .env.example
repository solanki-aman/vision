# Copy to .env before running docker compose
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.5

# Reasoning effort is paid on every step of a build turn, so it is the main
# latency lever: none | low | medium | high. Default "low" — raise it if chart
# choice or layout judgment starts to slip.
XAI_REASONING_EFFORT=low

# Search only extracts figures from pages someone else wrote, so it can run on a
# cheaper/faster model than the composer. Defaults to XAI_MODEL when unset.
# XAI_SEARCH_MODEL=grok-4.1-fast

# LangSmith tracing — every agent turn shows up as one trace: the graph loop, each
# tool call, and the web_search step that would otherwise be invisible. Leave
# LANGSMITH_TRACING unset to turn it off entirely.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_your_key_here
# LANGSMITH_PROJECT=vision
